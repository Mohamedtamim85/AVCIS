# Copy to .env (or set in your hosting panel) and adjust.

PORT=3000

# Leave empty to use SQLite (data/avcis.db). Set to use PostgreSQL, e.g. Neon:
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Long random string (min 32 chars). If empty, one is generated in data/.session-secret.
SESSION_SECRET=

# Creates the first admin on startup when no users exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to true when running behind a reverse proxy / load balancer that terminates HTTPS.
TRUST_PROXY=false
# auto = Secure cookie when the request is HTTPS. Set true to always require HTTPS.
COOKIE_SECURE=auto

# Login session length in hours.
SESSION_HOURS=12
